  import pentominoNames from "../images/pentomino-names.png"
  import MinoDiv from "$lib/components/MinoDiv.svelte"
  import { Polyomino } from "$lib/mino"
  import StateDiagramPicker from "../../StateDiagramPicker.svelte"

  // We need to define these here because svx auto-turns ASCII quote marks into fancy ones.
  const twoByFour = Polyomino.fromString("1111_1111")
  const thickL = Polyomino.fromString("1111_1111_0011_0011")
